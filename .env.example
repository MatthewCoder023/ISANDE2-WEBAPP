# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/flavor_and_color
SESSION_SECRET=replace-with-a-long-random-string

# Public base URL used in emailed links (reset links, order tracking).
APP_URL=http://localhost:3000

# Where uploaded payment proofs are written. Defaults to ./uploads next to
# the source, which is fine locally. On a host whose filesystem is wiped on
# restart or redeploy, point this at a mounted volume that persists —
# otherwise verified orders lose the evidence behind them.
UPLOAD_DIR=

# Outbound email (order notifications, password resets). Leave SMTP_HOST
# empty in development: messages are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flavor & Color <no-reply@example.com>"
